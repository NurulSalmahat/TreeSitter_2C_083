{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "filter",
      "camelcase": "Filter",
      "title": "Filter",
      "scope": "source.filter",
      "file-types": [
        "filter"
      ],
      "highlights": "queries/highlights.scm",
      "injection-regex": "^filter$",
      "class-name": "TreeSitterFilter"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "A simple filter query language for searching and filtering data.",
    "authors": [
      {
        "name": "Nurul Salmahat",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/NurulSalmahat/TreeSitter_2C_083.git",
      "funding": ""
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": true,
    "rust": false,
    "swift": false,
    "zig": false
  }
}